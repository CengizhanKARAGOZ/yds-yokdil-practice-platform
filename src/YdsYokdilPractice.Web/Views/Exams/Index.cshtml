@model YdsYokdilPractice.Web.ViewModels.ExamListViewModel

@{
    ViewData["Title"] = "Denemeler";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold">Denemeler</h1>
        <p class="text-muted">
            YDS ve YÖKDİL formatına uygun mini denemeler.
        </p>
    </div>

    @if (!Model.Exams.Any())
    {
        <div class="alert alert-warning">
            Henüz deneme bulunamadı.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var exam in Model.Exams)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary">@exam.ExamType</span>
                                <span class="badge bg-secondary">@exam.Level</span>
                            </div>

                            <h5 class="card-title">@exam.Title</h5>

                            <p class="card-text text-muted small">
                                @exam.Description
                            </p>

                            <ul class="list-unstyled small mb-3">
                                <li><strong>Alan:</strong> @exam.Field</li>
                                <li><strong>Soru:</strong> @exam.QuestionCount</li>
                                <li><strong>Süre:</strong> @exam.DurationMinutes dakika</li>
                            </ul>

                            <div class="d-grid gap-2">
                                <a asp-controller="Exams"
                                   asp-action="Solve"
                                   asp-route-id="@exam.Id"
                                   class="btn btn-primary">
                                    Deneme Çöz
                                </a>

                                <a asp-controller="Exams"
                                   asp-action="Details"
                                   asp-route-id="@exam.Id"
                                   class="btn btn-outline-secondary">
                                    İncele / Çalış
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>